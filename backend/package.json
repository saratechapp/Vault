{
  "name": "wallet-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node scripts/dev.js",
    "dev:api": "nodemon server.js",
    "test": "node --test '__tests__/*.test.js' 'src/**/__tests__/*.test.js'",
    "build:admin": "node scripts/build-admin.js",
    "build": "npm run build:admin"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@google/genai": "^2.21.0",
    "@supabase/supabase-js": "^2.110.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "heic-convert": "^2.1.0",
    "helmet": "^8.2.0",
    "morgan": "^1.10.0",
    "multer": "^2.3.0",
    "razorpay": "^2.9.8",
    "sharp": "^0.35.4",
    "stripe": "^22.6.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "nodemonConfig": {
    "ignore": [
      "sampledata.json",
      "sampledata.json.tmp",
      ".data-key",
      "admin"
    ],
    "ext": "js,json",
    "watch": [
      "server.js",
      "src",
      "package.json"
    ]
  }
}
