{
  "name": "wallet-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test '__tests__/*.test.js' 'services/__tests__/*.test.js'",
    "build:admin": "node scripts/build-admin.js",
    "build": "npm run build:admin"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "nodemonConfig": {
    "ignore": [
      "sampledata.json",
      "sampledata.json.tmp",
      ".data-key"
    ],
    "ext": "js,json",
    "watch": [
      "server.js",
      "db.js",
      "supabaseClient.js",
      "crypto.js",
      "plans.js",
      "services",
      "package.json"
    ]
  }
}
