# Override the default port (4000)
# PORT=4000

# Set to exactly 'development' to disable API rate limiting locally (two
# frontend apps + hot-reload burn through the production limit fast).
# Explicit opt-in on purpose — leave unset for production so a forgotten/
# misconfigured value fails safe (limiter stays on).
# NODE_ENV=development

# Supabase project URL and service-role key (Project Settings → API in the
# Supabase dashboard). The service-role key bypasses Row Level Security and
# must only ever live here, on the backend — never expose it to the frontend
# bundle or a browser-reachable env var (the frontend uses its own anon key
# for Supabase Auth calls instead).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 32-byte data-at-rest encryption key: 64 hex chars or base64.
# Leave unset to auto-generate backend/.data-key on first boot.
# Reserved for potential future field-level secrets — the AES-256-GCM helper
# in backend/crypto.js is no longer used to encrypt the whole datastore now
# that data lives in Postgres (Supabase encrypts at rest), but the file is
# kept in case a future feature needs to encrypt an individual sensitive
# field before it's stored.
# WALLET_DATA_KEY=

# Comma-separated list of allowed browser origins for CORS, e.g.
# https://app.example.com,https://example.com
# Leave blank for local dev (allows any origin) — set this in production.
# CORS_ORIGIN=

# Set to any value if the server runs behind a reverse proxy / load balancer
# (nginx, Cloudflare, ELB, etc). Makes Express trust X-Forwarded-For so
# rate limiting and logging see the real client IP. Do NOT set this if the
# server is directly internet-facing — it would let clients spoof their IP.
# TRUST_PROXY=

# --- Two-factor authentication (email OTP) ---
# Secret used to HMAC the 6-digit 2FA codes before they're stored, so a
# leaked two_factor_codes table can't be brute-forced offline. Any long
# random string. If unset, the backend falls back to SUPABASE_SERVICE_ROLE_KEY
# (works, but a dedicated secret is cleaner). Generate: openssl rand -hex 32
# TWO_FACTOR_SECRET=

# --- Receipt / bill / payment-screenshot scanner (POST /api/records/scan) ---
# Anthropic API key for the server-side vision call that reads a transaction
# out of an uploaded bill, receipt or GPay/PhonePe screenshot. Used ONLY by
# that one endpoint and never sent to any client bundle. If unset, the scan
# endpoint responds 502 and the mobile app falls back to "enter manually".
# Create one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Only set this if the key above is an identity-linked / workspace-scoped
# key (the API rejects those without a workspace id). A normal API key
# doesn't need it. Find the id in the Console workspace URL/settings.
# ANTHROPIC_WORKSPACE_ID=

# Canonical consumer-app origin (the Tailwind frontend/, not the admin/
# panel) — used to build the redirect URL for the impersonation magic link
# (POST /api/admin/users/:id/impersonate) so it lands on
# /impersonate-entry instead of Supabase's default Site URL.
# FRONTEND_URL=http://localhost:5173

# --- Recurring billing: Stripe (rest of world) + Razorpay (India) ---
# Every key below is OPTIONAL. With a provider's keys unset that provider is
# simply "not configured": POST /api/billing/subscribe for a user routed to it
# returns 503, its webhook returns 503, and the free-trial / enforcement flags
# behave exactly as they did before any billing existed. Read only by
# backend/src/services/billing/* — never sent to a client bundle EXCEPT the two
# publishable ids (STRIPE_PUBLISHABLE_KEY, RAZORPAY_KEY_ID), which are meant to
# be public and are returned from GET /api/billing/config.
#
# Stripe — https://dashboard.stripe.com/apikeys (use sk_test_… while testing).
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Webhook signing secret from the endpoint you create at
# https://dashboard.stripe.com/webhooks (or `stripe listen` prints a whsec_…).
# STRIPE_WEBHOOK_SECRET=whsec_xxx
#
# Razorpay — https://dashboard.razorpay.com/app/keys (rzp_test_… while testing).
# RAZORPAY_KEY_ID=rzp_test_xxx
# RAZORPAY_KEY_SECRET=xxx
# Webhook secret you set when creating the webhook in the Razorpay dashboard.
# RAZORPAY_WEBHOOK_SECRET=xxx
#
# Country(2-letter) -> provider routing, with a `*` wildcard fallback.
# Default: India on Razorpay, everyone else on Stripe.
# SUBSCRIPTION_PROVIDER_MAP=IN:razorpay,*:stripe
#
# Absolute public origin the app deep-links / the provider-hosted fallback
# redirects back to after checkout. Falls back to the first CORS origin, then
# http://localhost:5173.
# APP_PUBLIC_URL=https://app.example.com

# --- Admin panel build (backend/admin) ---
# REQUIRED for `npm run build` (scripts/build-admin.js hard-errors if either is
# missing); UNUSED by `npm start` / `npm run dev`. `npm run build` compiles
# backend/admin into backend/admin/dist, which this server serves under
# /superadmin, and Vite inlines these two public values into that bundle. Set
# them here (or in the deploy environment, e.g. Render). Same values as
# frontend/.env; the anon key is public and safe to embed. This is the only
# place the admin build reads them from — there is no backend/admin/.env.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
