# Override the default port (4000)
# PORT=4000

# Set to exactly 'development' to disable API rate limiting locally (two
# frontend apps + hot-reload burn through the production limit fast).
# Explicit opt-in on purpose — leave unset for production so a forgotten/
# misconfigured value fails safe (limiter stays on).
# NODE_ENV=development

# Supabase project URL and service-role key (Project Settings → API in the
# Supabase dashboard). The service-role key bypasses Row Level Security and
# must only ever live here, on the backend — never expose it to the frontend
# bundle or a browser-reachable env var (the frontend uses its own anon key
# for Supabase Auth calls instead).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 32-byte data-at-rest encryption key: 64 hex chars or base64.
# Leave unset to auto-generate backend/.data-key on first boot.
# Reserved for potential future field-level secrets — the AES-256-GCM helper
# in backend/crypto.js is no longer used to encrypt the whole datastore now
# that data lives in Postgres (Supabase encrypts at rest), but the file is
# kept in case a future feature needs to encrypt an individual sensitive
# field before it's stored.
# WALLET_DATA_KEY=

# Comma-separated list of allowed browser origins for CORS, e.g.
# https://app.example.com,https://example.com
# Leave blank for local dev (allows any origin) — set this in production.
# CORS_ORIGIN=

# Set to any value if the server runs behind a reverse proxy / load balancer
# (nginx, Cloudflare, ELB, etc). Makes Express trust X-Forwarded-For so
# rate limiting and logging see the real client IP. Do NOT set this if the
# server is directly internet-facing — it would let clients spoof their IP.
# TRUST_PROXY=

# Canonical consumer-app origin (the Tailwind frontend/, not the admin/
# panel) — used to build the redirect URL for the impersonation magic link
# (POST /api/admin/users/:id/impersonate) so it lands on
# /impersonate-entry instead of Supabase's default Site URL.
# FRONTEND_URL=http://localhost:5173

# --- Admin panel build (backend/admin) ---
# REQUIRED for `npm run build` (scripts/build-admin.js hard-errors if either is
# missing); UNUSED by `npm start` / `npm run dev`. `npm run build` compiles
# backend/admin into backend/admin/dist, which this server serves under
# /superadmin, and Vite inlines these two public values into that bundle. Set
# them here (or in the deploy environment, e.g. Render). Same values as
# frontend/.env; the anon key is public and safe to embed. backend/admin/.env
# is only for running the admin app standalone and is not read by the build.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
