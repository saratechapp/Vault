# Only needed to run or build backend/admin standalone (`npm run dev` /
# `npm run build` from this directory). The canonical build — `npm run build`
# from backend/ (scripts/build-admin.js) — reads VITE_SUPABASE_URL and
# VITE_SUPABASE_ANON_KEY from backend/.env or the deploy environment instead,
# so there is a single backend config source.
#
# Same Supabase project as frontend/.env — the admin panel reuses the same
# Auth pool (admin-ness is a row in the `admins` table, not a separate
# project). Only the public anon key ever ships in this bundle; every
# privileged Supabase Admin API call happens server-side in backend/.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
