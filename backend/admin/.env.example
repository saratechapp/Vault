# Same Supabase project as frontend/.env — the admin panel reuses the same
# Auth pool (admin-ness is a row in the `admins` table, not a separate
# project). Only the public anon key ever ships in this bundle; every
# privileged Supabase Admin API call happens server-side in backend/.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
